# Generated by Ansible. Do not edit manually.
# Internal Network: {{ gateway_internal_network }}
# Internal Interface: {{ gateway_internal_interface }}
# External Interface: {{ gateway_external_interface }}

*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow established and related connections
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# Allow forwarding from internal network to external (strict interface binding)
-A FORWARD -i {{ gateway_internal_interface }} -o {{ gateway_external_interface }} -s {{ gateway_internal_network }} -m conntrack --ctstate NEW -j ACCEPT

{% if gateway_enable_logging | bool %}
# Log dropped packets
-A FORWARD -j LOG --log-prefix "IPTables-Dropped: " --log-level 4
{% endif %}

{% for rule in gateway_extra_filter_rules %}
{{ rule }}
{% endfor %}

COMMIT

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

{% if gateway_nat_enabled | bool %}
# MASQUERADE for internal network
-A POSTROUTING -s {{ gateway_internal_network }} -o {{ gateway_external_interface }} -j MASQUERADE
{% endif %}

{% for rule in gateway_extra_nat_rules %}
{{ rule }}
{% endfor %}

COMMIT
