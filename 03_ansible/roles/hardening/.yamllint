---
extends: default

rules:
  line-length:
    max: 200
    level: warning
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
    check-keys: false
  comments:
    min-spaces-from-content: 1
  document-start: enable
  indentation:
    spaces: 2
    indent-sequences: true
  empty-lines:
    max: 1
  trailing-spaces: enable
