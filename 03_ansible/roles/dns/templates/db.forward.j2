$TTL    604800
@       IN      SOA     {{ dns_primary_ns }}.{{ dns_domain }}. admin.{{ dns_domain }}. (
                              {{ dns_zone_serial }}         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@       IN      NS      {{ dns_primary_ns }}.{{ dns_domain }}.

; A Records
{% for record in dns_records_a %}
{{ record.name }} IN A {{ record.ip }}
{% endfor %}

; CNAME Records
{% for record in dns_records_cname %}
{{ record.name }} IN CNAME {{ record.target }}.{{ dns_domain }}.
{% endfor %}
