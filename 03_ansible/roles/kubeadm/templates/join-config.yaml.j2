# Managed by Ansible - kubeadm role
{% set cp_host = kubeadm_bootstrap_host | default(groups[kubeadm_control_plane_group_name] | first, true) %}

apiVersion: kubeadm.k8s.io/v1beta3
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ kubeadm_api_endpoint | default(hostvars[cp_host]['ansible_default_ipv4']['address'], true) }}:6443"
    token: "{{ join_token }}"
    caCertHashes:
      - "sha256:{{ ca_hash }}"
  timeout: "{{ kubeadm_join_timeout }}"
{% if kubeadm_join_patches | length > 0 %}
patches:
{{ kubeadm_join_patches | to_nice_yaml(indent=2) }}
{% endif %}
{% if kubeadm_is_join_control_plane | bool %}
controlPlane:
  certificateKey: "{{ certificate_key }}"
{% endif %}
nodeRegistration:
  criSocket: "{{ kubeadm_container_runtime_endpoint }}"
  name: "{{ kubeadm_node_name | default(ansible_hostname) }}"
{% if kubeadm_node_taints | length > 0 %}
  taints:
{% for taint in kubeadm_node_taints %}
    - {{ taint }}
{% endfor %}
{% endif %}
{% if kubeadm_node_labels | length > 0 %}
  kubeletExtraArgs:
    node-labels: "{% for key, value in kubeadm_node_labels.items() %}{{ key }}={{ value }}{% if not loop.last %},{% endif %}{% endfor %}"
{% endif %}
