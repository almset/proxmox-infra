---
- name: Post-installation validation
  block:
    - name: Verify control plane health (readyz)
      ansible.builtin.command:
        cmd: "{{ rke2_kubectl_cmd }} get --raw='/readyz'"
      register: _readyz
      changed_when: false
      failed_when: "'ok' not in _readyz.stdout"

    - name: Verify no nodes are in NotReady state
      ansible.builtin.command:
        cmd: "{{ rke2_kubectl_cmd }} get nodes --no-headers"
      register: _nodes_status
      changed_when: false
      failed_when: "'NotReady' in _nodes_status.stdout"

#- name: Wait for critical system pods to be ready
