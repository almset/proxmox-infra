#    - name: Wait for 1all system components to be ready
#      ansible.builtin.command:
#        cmd: >-
#          {{ rke2_kubectl_cmd }}
#          wait --for=condition=Ready pods --all -n kube-system
#          --timeout=120s
#      register: _system_pods_ready
#      changed_when: false
#      failed_when: _system_pods_ready.rc != 0
- name: Wait for core system components to be ready
  ansible.builtin.command:
    cmd: >-
      {{ rke2_kubectl_cmd }}
      wait --for=condition=Ready pods -n kube-system
      -l 'k8s-app in (kube-dns, metrics-server, calico-node)'
      --timeout=120s
  register: _system_pods_ready
  changed_when: false
  failed_when: _system_pods_ready.rc != 0

  when: not ansible_check_mode
